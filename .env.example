# OPENROUTER_API_KEY: Required for OpenRouter API calls.
# Users configure this via the Secrets panel (Settings > Secrets) in the AI Studio UI.
OPENROUTER_API_KEY="PASTE_YOUR_OPENROUTER_API_KEY_HERE"

# GEMINI_API_KEY: Optional, if you still want to use native Gemini.
GEMINI_API_KEY="PASTE_YOUR_API_KEY_HERE"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
